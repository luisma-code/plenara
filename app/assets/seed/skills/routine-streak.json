{
  "skillId": "routine-streak",
  "displayName": "Your routine streak",
  "_comment": "Reuses the existing current_streak/longest_streak fns over routine_session.date. NOTE the shape: the DSL has no early return, so the trailing computation is duplicated INSIDE each branch — a guard that only sets confirmationText would be overwritten by the format step that follows it.",
  "reads": [
    "routine",
    "routine_session"
  ],
  "writes": [],
  "inputs": [
    {
      "name": "routineName",
      "required": false
    }
  ],
  "steps": {
    "main": [
      {
        "op": "branch",
        "cond": {
          "isNull": "routineName"
        },
        "then": [
          {
            "op": "read_many",
            "typeId": "routine_session",
            "orderBy": "date",
            "orderDir": "desc",
            "into": "sessions"
          },
          {
            "op": "set",
            "var": "label",
            "value": "movement"
          },
          {
            "op": "compute",
            "fn": "current_streak",
            "args": [
              {
                "var": "sessions"
              },
              "date"
            ],
            "into": "cur"
          },
          {
            "op": "compute",
            "fn": "longest_streak",
            "args": [
              {
                "var": "sessions"
              },
              "date"
            ],
            "into": "best"
          },
          {
            "op": "compute",
            "fn": "count",
            "args": [
              {
                "var": "sessions"
              }
            ],
            "into": "n"
          },
          {
            "op": "branch",
            "cond": {
              "gte": [
                0,
                {
                  "var": "n"
                }
              ]
            },
            "then": [
              {
                "op": "format",
                "template": "No {label} sessions logged yet.",
                "into": "confirmationText"
              }
            ],
            "else": [
              {
                "op": "format",
                "template": "{label}: {cur} day streak, best {best}, {n} session(s) all up.",
                "into": "confirmationText"
              }
            ]
          }
        ],
        "else": [
          {
            "op": "read_one",
            "typeId": "routine",
            "match": {
              "title": {
                "var": "routineName"
              }
            },
            "partial": true,
            "into": "r"
          },
          {
            "op": "branch",
            "cond": {
              "isNull": "r"
            },
            "then": [
              {
                "op": "format",
                "template": "I don't have a routine called {routineName}.",
                "into": "confirmationText"
              }
            ],
            "else": [
              {
                "op": "read_related",
                "typeId": "routine_session",
                "via": "routine",
                "from": {
                  "ref": "r"
                },
                "orderBy": "date",
                "orderDir": "desc",
                "into": "sessions"
              },
              {
                "op": "set",
                "var": "label",
                "value": {
                  "field": [
                    "r",
                    "title"
                  ]
                }
              },
              {
                "op": "compute",
                "fn": "current_streak",
                "args": [
                  {
                    "var": "sessions"
                  },
                  "date"
                ],
                "into": "cur"
              },
              {
                "op": "compute",
                "fn": "longest_streak",
                "args": [
                  {
                    "var": "sessions"
                  },
                  "date"
                ],
                "into": "best"
              },
              {
                "op": "compute",
                "fn": "count",
                "args": [
                  {
                    "var": "sessions"
                  }
                ],
                "into": "n"
              },
              {
                "op": "branch",
                "cond": {
                  "gte": [
                    0,
                    {
                      "var": "n"
                    }
                  ]
                },
                "then": [
                  {
                    "op": "format",
                    "template": "No {label} sessions logged yet.",
                    "into": "confirmationText"
                  }
                ],
                "else": [
                  {
                    "op": "format",
                    "template": "{label}: {cur} day streak, best {best}, {n} session(s) all up.",
                    "into": "confirmationText"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}