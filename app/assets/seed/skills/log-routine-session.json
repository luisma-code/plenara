{
  "skillId": "log-routine-session",
  "displayName": "Log a completed routine",
  "_comment": "Dispatched by the routine player when a run ends, so finishing a routine is an ordinary act-then-describe write: journaled, undoable, and visible to automations — not a side channel. Resolves the routine by ID, never by title: two routines can share a title (read_one would raise an ambiguity and the session would be silently lost), and a rename or delete mid-run would strand it.",
  "reads": [
    "routine"
  ],
  "writes": [
    "routine_session"
  ],
  "inputs": [
    {
      "name": "routineId",
      "required": true
    },
    {
      "name": "stepsCompleted",
      "required": false
    },
    {
      "name": "stepsTotal",
      "required": false
    }
  ],
  "steps": {
    "main": [
      {
        "op": "read_one",
        "typeId": "routine",
        "match": {
          "id": {
            "var": "routineId"
          }
        },
        "into": "r"
      },
      {
        "op": "branch",
        "cond": {
          "isNull": "r"
        },
        "then": [
          {
            "op": "format",
            "template": "I couldn't find that routine to log it.",
            "into": "confirmationText"
          }
        ],
        "else": [
          {
            "op": "set",
            "var": "rtitle",
            "value": {
              "field": [
                "r",
                "title"
              ]
            }
          },
          {
            "op": "compute",
            "fn": "today",
            "args": [],
            "into": "today"
          },
          {
            "op": "compute",
            "fn": "now",
            "args": [],
            "into": "nowTs"
          },
          {
            "op": "write_record",
            "typeId": "routine_session",
            "into": "s",
            "fields": {
              "routine": {
                "field": [
                  "r",
                  "id"
                ]
              },
              "routineTitle": {
                "field": [
                  "r",
                  "title"
                ]
              },
              "date": {
                "var": "today"
              },
              "completedAt": {
                "var": "nowTs"
              },
              "stepsCompleted": {
                "var": "stepsCompleted"
              },
              "stepsTotal": {
                "var": "stepsTotal"
              }
            }
          },
          {
            "op": "format",
            "template": "Logged — {rtitle} done.",
            "into": "confirmationText"
          }
        ]
      }
    ]
  }
}